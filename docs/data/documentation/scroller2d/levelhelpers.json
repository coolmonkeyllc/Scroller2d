{"hierarchy":{"paths":[["doc:\/\/Scroller2d\/documentation\/Scroller2d"]]},"primaryContentSections":[{"content":[{"text":"Supported directions","anchor":"Supported-directions","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each helper has its own scope:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Helper"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Direction support"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LevelAssemblyHelper.Resources"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Loads level and catalog models independently of camera-follow direction."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LevelAssemblyHelper.build"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Assembles horizontal levels; requires "},{"type":"codeVoice","code":"scrollOrientation"},{"type":"text","text":" to be "},{"type":"codeVoice","code":"\"horizontal\""},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CreateGroundHelper"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Constructs flat horizontal terrain and gaps."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CameraFollowHelper"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Follows horizontally, vertically, or on both axes independently of the assembly and ground helpers."}]}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"You can use the camera helper independently in a vertical-scrolling or free-moving","type":"text"},{"text":" ","type":"text"},{"text":"2D game with your own scene and terrain construction.","type":"text"}],"type":"paragraph"},{"text":"Load and assemble","type":"heading","level":2,"anchor":"Load-and-assemble"},{"inlineContent":[{"text":"Call these helpers on the main actor, after configuring the SDK’s ","type":"text"},{"type":"codeVoice","code":"runningDevice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"defaultDevice"},{"text":" for your game. URLs may come from your app bundle or workspace.","type":"text"},{"text":" ","type":"text"},{"text":"The level file uses the existing ","type":"text"},{"type":"codeVoice","code":"SceneConfig"},{"text":" format. Obstacle and character catalogs","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"type":"codeVoice","code":"ObstacleConfig"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"CharacterConfig"},{"text":"; the object catalog is an array of ","type":"text"},{"type":"codeVoice","code":"GenericObject"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let resources = try LevelAssemblyHelper.Resources(","    levelURL: levelURL,","    obstacleURL: obstacleURL,","    characterURL: characterURL,","    objectURL: objectURL",")","let result = try LevelAssemblyHelper.build(","    resources: resources,","    scene: self,","    groundTexture: { name in SKTexture(imageNamed: name) }",")","result.install(in: self)"]},{"inlineContent":[{"type":"codeVoice","code":"self"},{"text":" is an ","type":"text"},{"type":"codeVoice","code":"AppSharedSceneBase"},{"text":". The result exposes the world root, ground geometry,","type":"text"},{"text":" ","type":"text"},{"text":"obstacle nodes, and character nodes. Installing applies scene size, anchor point, and","type":"text"},{"text":" ","type":"text"},{"text":"scale mode, attaches the root, and commits the ground lookup and ","type":"text"},{"type":"codeVoice","code":"levelEndPoint"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Remove the previous result’s root before installing a different level.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Catalog properties supply defaults. Non-nil per-level properties override them, nested","type":"text"},{"type":"text","text":" "},{"type":"text","text":"properties merge, and device records merge by their exact "},{"type":"codeVoice","code":"deviceName"},{"type":"text","text":" string. An explicit"},{"type":"text","text":" "},{"type":"text","text":"empty array clears a catalog array. Missing definitions and decoding failures throw."}]},{"inlineContent":[{"type":"text","text":"Assembly uses "},{"type":"codeVoice","code":"CreateObstacleHelper"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CreateCharacterHelper"},{"type":"text","text":", retaining the existing"},{"type":"text","text":" "},{"text":"SDK animation, physics, and behavior. Their image names must resolve through the scene’s","type":"text"},{"type":"text","text":" "},{"text":"normal texture cache and bundled assets. ","type":"text"},{"type":"codeVoice","code":"groundTexture"},{"text":" resolves terrain only and can","type":"text"},{"text":" ","type":"text"},{"text":"map editor names to namespaced asset catalog names. Use ","type":"text"},{"type":"codeVoice","code":"configureObstacle"},{"text":" to adjust","type":"text"},{"text":" ","type":"text"},{"text":"resolved obstacle properties before construction.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The default character factory produces the SDK’s enemy node class. Use ","type":"text"},{"type":"codeVoice","code":"createCharacter"},{"text":" ","type":"text"},{"text":"to customize or skip individual characters. Add your player, backgrounds, coins, artifacts,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"checkpoints, and end triggers through "},{"type":"codeVoice","code":"addContent"},{"type":"text","text":", which receives the loaded resources,"},{"type":"text","text":" "},{"type":"text","text":"world root, and ground result. These callbacks are synchronous and may throw. Assembly"},{"type":"text","text":" "},{"type":"text","text":"temporarily attaches its root so the existing scene-coordinate conversion helpers work,"},{"type":"text","text":" "},{"type":"text","text":"then detaches it before returning. It restores the previous ground lookup and end point"},{"type":"text","text":" "},{"type":"text","text":"on success or failure. Keep callback side effects within the supplied root."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Input, collision responses, collection rules, checkpoint state, victory UI, and replay"},{"type":"text","text":" "},{"type":"text","text":"remain game-specific. Assembly does not automatically install scene\/contact delegates."}]},{"text":"Construct ground independently","anchor":"Construct-ground-independently","level":2,"type":"heading"},{"type":"codeListing","syntax":"swift","code":["let terrain = try CreateGroundHelper(","    sections: resources.level.ground ?? [],","    origin: CGPoint(x: -437, y: -201),","    texture: { SKTexture(imageNamed: $0) }",")","addChild(terrain.root)","terrain.installGroundLookup(in: self)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The builder supports flat horizontal "},{"type":"codeVoice","code":"Ground"},{"type":"text","text":" sections, optional bottom-layer tiles,"},{"type":"text","text":" "},{"type":"text","text":"repeat counts, device sizes and offsets, anchors, z positions, and gap materials."},{"type":"text","text":" "},{"type":"text","text":"An optional "},{"type":"codeVoice","code":"collisionTopInset"},{"type":"text","text":" lowers the collision surface without resizing artwork;"},{"type":"text","text":" "},{"type":"text","text":"assembly exposes the same setting as "},{"type":"codeVoice","code":"groundCollisionTopInset"},{"type":"text","text":". Adjacent"},{"type":"text","text":" "},{"type":"text","text":"surfaces with matching geometry and collision masks share a static collision body."},{"type":"text","text":" "},{"type":"text","text":"Set masks per section in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/GroundSection\/collisionMasks"},{"type":"text","text":". Returned surfaces describe"},{"type":"text","text":" "},{"type":"text","text":"the full collision rectangles; the SDK ground lookup stores their top edges. "},{"type":"codeVoice","code":"bounds"},{"type":"text","text":" "},{"type":"text","text":"includes horizontal gaps, and "},{"type":"codeVoice","code":"endPoint"},{"type":"text","text":" is the ground cursor at the baseline."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use identity transforms for the world and terrain roots so the lookup remains in scene"},{"type":"text","text":" "},{"type":"text","text":"coordinates. Sloped terrain and stacked sections require a custom builder."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"Gap"},{"type":"text","text":" for water, lava, fire, or other artwork between ground sections. The"},{"type":"text","text":" "},{"type":"codeVoice","code":"distance"},{"type":"text","text":" width moves the terrain cursor, and the width and height set the"},{"type":"text","text":" "},{"type":"text","text":"sprite size. The artwork starts at the terrain baseline, plus any device Y"},{"type":"text","text":" "},{"type":"text","text":"offset. Use "},{"type":"codeVoice","code":"None"},{"type":"text","text":" with a width for an empty span. Gap materials have no floor"},{"type":"text","text":" "},{"type":"text","text":"collision. Add a game-specific sensor if contact should trigger swimming or damage."}]},{"inlineContent":[{"type":"text","text":"For a static fill, set "},{"type":"codeVoice","code":"image"},{"type":"text","text":" to a texture name. For waves or flicker, set"},{"type":"text","text":" "},{"type":"codeVoice","code":"image"},{"type":"text","text":" to a sprite atlas name and set the section’s "},{"type":"codeVoice","code":"animation"},{"type":"text","text":" dictionary."},{"type":"text","text":" "},{"type":"text","text":"See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/GroundSection"},{"type":"text","text":" for a two-frame example. The optional"},{"type":"text","text":" "},{"type":"codeVoice","code":"gapAnimationTextures"},{"type":"text","text":" resolver can supply ordered frames from a custom asset store."}],"type":"paragraph"},{"inlineContent":[{"text":"Bounds describe terrain, so extend them for any playable area beyond it.","type":"text"}],"type":"paragraph"},{"text":"Follow a target horizontally, vertically, or in all 2D directions","anchor":"Follow-a-target-horizontally-vertically-or-in-all-2D-directions","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"CameraFollowHelper"},{"type":"text","text":" supports independent horizontal and vertical axis controls."},{"text":" ","type":"text"},{"text":"Horizontal following is enabled by default, and vertical following is disabled.","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Follow mode"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"followsHorizontal"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"followsVertical"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Horizontal (default)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertical"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"All 2D directions"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Neither axis"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"A disabled axis retains the camera’s existing position. Enabling both axes follows","type":"text"},{"text":" ","type":"text"},{"text":"any combination of horizontal, vertical, and diagonal target movement; it does not","type":"text"},{"text":" ","type":"text"},{"text":"rotate the camera or automatically change zoom.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Retain the helper as a scene property and update it after physics. This example","type":"text"},{"text":" ","type":"text"},{"text":"follows the target on both axes:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let follow = CameraFollowHelper(","    camera: cameraNode,","    target: hero,","    viewportSize: visibleWorldSize,","    bounds: playableBounds",")","follow.followsHorizontal = true","follow.followsVertical = true","follow.lookAhead = .zero","follow.smoothing = 8","","\/\/ From the scene's didSimulatePhysics hook:","follow.update(deltaTime: frameDelta)"]},{"inlineContent":[{"text":"For vertical-only following, set ","type":"text"},{"type":"codeVoice","code":"followsHorizontal = false"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"followsVertical = true"},{"text":". For horizontal-only following, use the defaults.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Smoothing and look-ahead work on each enabled axis. Smoothing is an exponential","type":"text"},{"text":" ","type":"text"},{"text":"response per second; zero snaps immediately. Set ","type":"text"},{"type":"codeVoice","code":"lookAhead.dx"},{"text":" for a horizontal","type":"text"},{"text":" ","type":"text"},{"text":"offset and ","type":"text"},{"type":"codeVoice","code":"lookAhead.dy"},{"text":" for a vertical offset. These offsets are fixed in","type":"text"},{"text":" ","type":"text"},{"text":"camera-parent coordinates; they do not automatically reverse with target movement.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Optional ","type":"text"},{"type":"codeVoice","code":"bounds"},{"text":" constrain each enabled axis and use camera-parent coordinates.","type":"text"},{"text":" ","type":"text"},{"text":"A world smaller than the viewport centers on that axis. Supply bounds covering the","type":"text"},{"text":" ","type":"text"},{"text":"full playable height for vertical or all-direction following. Terrain-only bounds","type":"text"},{"text":" ","type":"text"},{"text":"that are no taller than the viewport prevent vertical travel even when","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"followsVertical"},{"text":" is enabled. Set ","type":"text"},{"type":"codeVoice","code":"bounds = nil"},{"text":" for unrestricted following. Update ","type":"text"},{"type":"codeVoice","code":"viewportSize"},{"text":" when the view, scale mode, or camera zoom changes;","type":"text"},{"text":" ","type":"text"},{"text":"it must describe the visible world dimensions, rather than screen pixels. Keep the","type":"text"},{"text":" ","type":"text"},{"text":"camera unrotated. The helper handles target coordinate conversion, weak references,","type":"text"},{"text":" ","type":"text"},{"text":"invalid frame deltas, and targets removed from the scene. Reset your frame timer after","type":"text"},{"text":" ","type":"text"},{"text":"pausing to avoid a large resume delta.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/LevelHelpers"},"kind":"article","metadata":{"title":"Assemble Levels, Construct Ground, and Follow Targets","modules":[{"name":"Scroller2d"}],"roleHeading":"Article","role":"article"},"abstract":[{"text":"Load your level and catalogs, construct horizontal ground, and follow a character","type":"text"},{"text":" ","type":"text"},{"text":"horizontally, vertically, or in all 2D directions with reusable API helpers.","type":"text"}],"seeAlsoSections":[{"anchor":"Essentials","identifiers":["doc:\/\/Scroller2d\/documentation\/Scroller2d\/GettingStarted","doc:\/\/Scroller2d\/documentation\/Scroller2d\/DecisionPoint","doc:\/\/Scroller2d\/documentation\/Scroller2d\/AppSharedSceneBaseLifecycle","doc:\/\/Scroller2d\/documentation\/Scroller2d\/ManagedCallbacks","doc:\/\/Scroller2d\/documentation\/Scroller2d\/BaseClasses","doc:\/\/Scroller2d\/documentation\/Scroller2d\/BaseTypeStructure","doc:\/\/Scroller2d\/documentation\/Scroller2d\/SharedObjects","doc:\/\/Scroller2d\/documentation\/Scroller2d\/Configuration","doc:\/\/Scroller2d\/documentation\/Scroller2d\/Extensions","doc:\/\/Scroller2d\/documentation\/Scroller2d\/Enumerations","doc:\/\/Scroller2d\/documentation\/Scroller2d\/Other"],"generated":true,"title":"Essentials"}],"variants":[{"paths":["\/documentation\/scroller2d\/levelhelpers"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://Scroller2d/documentation/Scroller2d/AppSharedSceneBase":{"identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/AppSharedSceneBase","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"AppSharedSceneBase","kind":"identifier"}],"type":"topic","title":"AppSharedSceneBase","kind":"symbol","url":"\/documentation\/scroller2d\/appsharedscenebase","navigatorTitle":[{"text":"AppSharedSceneBase","kind":"identifier"}],"abstract":[{"type":"text","text":"The base SKScene implementation for Scroller2d."}]},"appicon.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/Scroller2d\/appicon.png"}],"type":"image","alt":"Scroller2d","identifier":"appicon.png"},"doc://Scroller2d/documentation/Scroller2d/Extensions":{"role":"collectionGroup","abstract":[{"type":"text","text":"Browse the core data types that define levels, scenes, and gameplay objects."}],"type":"topic","title":"Extensions","kind":"article","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/Extensions","url":"\/documentation\/scroller2d\/extensions"},"doc://Scroller2d/documentation/Scroller2d/ManagedCallbacks":{"title":"How does Scroller2d manage callbacks","abstract":[{"type":"text","text":"Deciding to use the game object helpers or roll your own."}],"type":"topic","role":"article","url":"\/documentation\/scroller2d\/managedcallbacks","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/ManagedCallbacks","kind":"article"},"doc://Scroller2d/documentation/Scroller2d/GettingStarted":{"title":"Getting Started with Scroller2d","abstract":[{"type":"text","text":"Create a level and assign background and ground elements."}],"role":"article","url":"\/documentation\/scroller2d\/gettingstarted","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/GettingStarted","type":"topic","kind":"article"},"doc://Scroller2d/documentation/Scroller2d/GroundSection/collisionMasks":{"title":"collisionMasks","abstract":[{"text":"The category, collision, and contact masks for a solid ground section.","type":"text"}],"type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"collisionMasks","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10Scroller2d18CollisionDetectionV","text":"CollisionDetection","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol","url":"\/documentation\/scroller2d\/groundsection\/collisionmasks","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/GroundSection\/collisionMasks","kind":"symbol"},"doc://Scroller2d/documentation/Scroller2d/AppSharedSceneBaseLifecycle":{"title":"AppSharedSceneBase Lifecycle","abstract":[{"type":"text","text":"When using "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/AppSharedSceneBase"},{"type":"text","text":" how does Scroller2d provide feedback to my code."}],"type":"topic","role":"article","url":"\/documentation\/scroller2d\/appsharedscenebaselifecycle","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/AppSharedSceneBaseLifecycle","kind":"article"},"doc://Scroller2d/documentation/Scroller2d/Configuration":{"role":"collectionGroup","abstract":[{"type":"text","text":"Browse the core data types that define levels, scenes, and gameplay objects."}],"type":"topic","kind":"article","title":"Configuration","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/Configuration","url":"\/documentation\/scroller2d\/configuration"},"doc://Scroller2d/documentation/Scroller2d/DecisionPoint":{"type":"topic","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/DecisionPoint","url":"\/documentation\/scroller2d\/decisionpoint","abstract":[{"type":"text","text":"Deciding to use the game object helpers or roll your own."}],"role":"article","kind":"article","title":"Decision Point"},"doc://Scroller2d/documentation/Scroller2d/GroundSection":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GroundSection"}],"role":"symbol","abstract":[{"type":"text","text":"A structure representing all the properties and types needed to create a specific horizontal ground section."}],"kind":"symbol","title":"GroundSection","type":"topic","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/GroundSection","url":"\/documentation\/scroller2d\/groundsection","navigatorTitle":[{"kind":"identifier","text":"GroundSection"}]},"doc://Scroller2d/documentation/Scroller2d/Enumerations":{"identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/Enumerations","role":"collectionGroup","kind":"article","title":"Enumerations","type":"topic","url":"\/documentation\/scroller2d\/enumerations","abstract":[{"text":"Browse the core data types that define levels, scenes, and gameplay objects.","type":"text"}]},"doc://Scroller2d/documentation/Scroller2d/Other":{"type":"topic","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/Other","url":"\/documentation\/scroller2d\/other","abstract":[{"type":"text","text":"Browse the core data types that define levels, scenes, and gameplay objects."}],"role":"collectionGroup","kind":"article","title":"Other"},"doc://Scroller2d/documentation/Scroller2d":{"role":"collection","url":"\/documentation\/scroller2d","type":"topic","images":[{"type":"icon","identifier":"appicon.png"}],"identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d","abstract":[{"type":"text","text":"Scroller2d is an api interface and visual editor that allows a developer to quickly create 2d SpriteKit games with minimal effort."}],"title":"Scroller2d","kind":"symbol"},"doc://Scroller2d/documentation/Scroller2d/BaseTypeStructure":{"identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/BaseTypeStructure","abstract":[{"type":"text","text":"Browse the core data types that define levels, scenes, and gameplay objects."}],"type":"topic","kind":"article","title":"Base Structure","url":"\/documentation\/scroller2d\/basetypestructure","role":"collectionGroup"},"doc://Scroller2d/documentation/Scroller2d/SharedObjects":{"title":"Shared Structures","abstract":[{"type":"text","text":"Browse the core data types that define levels, scenes, and gameplay objects."}],"role":"collectionGroup","url":"\/documentation\/scroller2d\/sharedobjects","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/SharedObjects","type":"topic","kind":"article"},"doc://Scroller2d/documentation/Scroller2d/BaseClasses":{"title":"Base Classes","abstract":[{"type":"text","text":"Browse the core data types that define levels, scenes, and gameplay objects."}],"role":"collectionGroup","url":"\/documentation\/scroller2d\/baseclasses","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/BaseClasses","type":"topic","kind":"article"}}}