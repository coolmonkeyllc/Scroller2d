{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"type":"text","text":"Load your level and catalogs, construct horizontal ground, and follow a character"},{"type":"text","text":" "},{"type":"text","text":"horizontally, vertically, or in all 2D directions with reusable API helpers."}],"identifier":{"url":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/LevelHelpers","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"Scroller2d"}],"roleHeading":"Article","role":"article","title":"Assemble Levels, Construct Ground, and Follow Targets"},"kind":"article","seeAlsoSections":[{"anchor":"Essentials","generated":true,"title":"Essentials","identifiers":["doc:\/\/Scroller2d\/documentation\/Scroller2d\/GettingStarted","doc:\/\/Scroller2d\/documentation\/Scroller2d\/DecisionPoint","doc:\/\/Scroller2d\/documentation\/Scroller2d\/AppSharedSceneBaseLifecycle","doc:\/\/Scroller2d\/documentation\/Scroller2d\/ManagedCallbacks","doc:\/\/Scroller2d\/documentation\/Scroller2d\/BaseClasses","doc:\/\/Scroller2d\/documentation\/Scroller2d\/BaseTypeStructure","doc:\/\/Scroller2d\/documentation\/Scroller2d\/SharedObjects","doc:\/\/Scroller2d\/documentation\/Scroller2d\/Configuration","doc:\/\/Scroller2d\/documentation\/Scroller2d\/Extensions","doc:\/\/Scroller2d\/documentation\/Scroller2d\/Enumerations","doc:\/\/Scroller2d\/documentation\/Scroller2d\/Other"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Supported directions","type":"heading","anchor":"Supported-directions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each helper has its own scope:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Helper","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Direction support","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"LevelAssemblyHelper.Resources","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Loads level and catalog models independently of camera-follow direction.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"LevelAssemblyHelper.build","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Assembles horizontal levels; requires ","type":"text"},{"code":"scrollOrientation","type":"codeVoice"},{"text":" to be ","type":"text"},{"code":"\"horizontal\"","type":"codeVoice"},{"text":".","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"GroundConstructionHelper","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Constructs flat horizontal terrain and gaps.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"CameraFollowHelper","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Follows horizontally, vertically, or on both axes independently of the assembly and ground helpers.","type":"text"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use the camera helper independently in a vertical-scrolling or free-moving"},{"type":"text","text":" "},{"type":"text","text":"2D game with your own scene and terrain construction."}]},{"type":"heading","level":2,"anchor":"Load-and-assemble","text":"Load and assemble"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call these helpers on the main actor, after configuring the SDK’s "},{"type":"codeVoice","code":"runningDevice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"defaultDevice"},{"type":"text","text":" for your game. URLs may come from your app bundle or workspace."},{"type":"text","text":" "},{"type":"text","text":"The level file uses the existing "},{"type":"codeVoice","code":"SceneConfig"},{"type":"text","text":" format. Obstacle and character catalogs"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"codeVoice","code":"ObstacleConfig"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CharacterConfig"},{"type":"text","text":"; the object catalog is an array of "},{"type":"codeVoice","code":"GenericObject"},{"type":"text","text":"."}]},{"code":["let resources = try LevelAssemblyHelper.Resources(","    levelURL: levelURL,","    obstacleURL: obstacleURL,","    characterURL: characterURL,","    objectURL: objectURL",")","let result = try LevelAssemblyHelper.build(","    resources: resources,","    scene: self,","    groundTexture: { name in SKTexture(imageNamed: name) }",")","result.install(in: self)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"self","type":"codeVoice"},{"text":" is an ","type":"text"},{"code":"AppSharedSceneBase","type":"codeVoice"},{"text":". The result exposes the world root, ground geometry,","type":"text"},{"text":" ","type":"text"},{"text":"obstacle nodes, and character nodes. Installing applies scene size, anchor point, and","type":"text"},{"text":" ","type":"text"},{"text":"scale mode, attaches the root, and commits the ground lookup and ","type":"text"},{"code":"levelEndPoint","type":"codeVoice"},{"text":".","type":"text"},{"type":"text","text":" "},{"text":"Remove the previous result’s root before installing a different level.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Catalog properties supply defaults. Non-nil per-level properties override them, nested","type":"text"},{"type":"text","text":" "},{"type":"text","text":"properties merge, and device records merge by their exact "},{"type":"codeVoice","code":"deviceName"},{"type":"text","text":" string. An explicit"},{"type":"text","text":" "},{"type":"text","text":"empty array clears a catalog array. Missing definitions and decoding failures throw."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Assembly uses "},{"type":"codeVoice","code":"CreateObstacleHelper"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CreateCharacterHelper"},{"type":"text","text":", retaining the existing"},{"type":"text","text":" "},{"type":"text","text":"SDK animation, physics, and behavior. Their image names must resolve through the scene’s"},{"type":"text","text":" "},{"type":"text","text":"normal texture cache and bundled assets. "},{"type":"codeVoice","code":"groundTexture"},{"type":"text","text":" resolves terrain only and can"},{"text":" ","type":"text"},{"text":"map editor names to namespaced asset catalog names. Use ","type":"text"},{"code":"configureObstacle","type":"codeVoice"},{"text":" to adjust","type":"text"},{"text":" ","type":"text"},{"text":"resolved obstacle properties before construction.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The default character factory produces the SDK’s enemy node class. Use ","type":"text"},{"code":"createCharacter","type":"codeVoice"},{"text":" ","type":"text"},{"text":"to customize or skip individual characters. Add your player, backgrounds, coins, artifacts,","type":"text"},{"text":" ","type":"text"},{"text":"checkpoints, and end triggers through ","type":"text"},{"type":"codeVoice","code":"addContent"},{"type":"text","text":", which receives the loaded resources,"},{"type":"text","text":" "},{"text":"world root, and ground result. These callbacks are synchronous and may throw. Assembly","type":"text"},{"type":"text","text":" "},{"type":"text","text":"temporarily attaches its root so the existing scene-coordinate conversion helpers work,"},{"type":"text","text":" "},{"type":"text","text":"then detaches it before returning. It restores the previous ground lookup and end point"},{"type":"text","text":" "},{"type":"text","text":"on success or failure. Keep callback side effects within the supplied root."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Input, collision responses, collection rules, checkpoint state, victory UI, and replay"},{"type":"text","text":" "},{"type":"text","text":"remain game-specific. Assembly does not automatically install scene\/contact delegates."}]},{"anchor":"Construct-ground-independently","type":"heading","text":"Construct ground independently","level":2},{"type":"codeListing","syntax":"swift","code":["let terrain = try GroundConstructionHelper.build(","    sections: resources.level.ground ?? [],","    origin: CGPoint(x: -437, y: -201),","    texture: { SKTexture(imageNamed: $0) },","    categoryBitMask: groundMask,","    collisionBitMask: playerMask,","    contactTestBitMask: playerMask",")","addChild(terrain.root)","terrain.installGroundLookup(in: self)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The builder supports flat horizontal "},{"type":"codeVoice","code":"Ground"},{"type":"text","text":" sections, optional bottom-layer tiles,"},{"type":"text","text":" "},{"type":"text","text":"repeat counts, device sizes and offsets, anchors, z positions, and "},{"type":"codeVoice","code":"None"},{"type":"text","text":" gaps."},{"type":"text","text":" "},{"type":"text","text":"An optional "},{"type":"codeVoice","code":"collisionTopInset"},{"type":"text","text":" lowers the collision surface without resizing artwork;"},{"type":"text","text":" "},{"type":"text","text":"assembly exposes the same setting as "},{"type":"codeVoice","code":"groundCollisionTopInset"},{"type":"text","text":". Adjacent"},{"type":"text","text":" "},{"type":"text","text":"surfaces with matching heights share a static collision body. Returned surfaces describe"},{"type":"text","text":" "},{"type":"text","text":"the full collision rectangles; the SDK ground lookup stores their top edges. "},{"type":"codeVoice","code":"bounds"},{"type":"text","text":" "},{"type":"text","text":"includes horizontal gaps, and "},{"type":"codeVoice","code":"endPoint"},{"type":"text","text":" is the ground cursor at the baseline."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use identity transforms for the world and terrain roots so the lookup remains in scene"},{"type":"text","text":" "},{"type":"text","text":"coordinates. Sloped terrain, stacked sections, and hazard ground types currently throw"},{"type":"text","text":" "},{"type":"codeVoice","code":"LevelAssemblyError.unsupported"},{"type":"text","text":"; they need a custom ground builder. Gap distance uses"},{"type":"text","text":" "},{"type":"text","text":"its horizontal component. Bounds describe terrain, so extend them vertically for your"},{"type":"text","text":" "},{"type":"text","text":"camera and include any playable area beyond the terrain."}]},{"anchor":"Follow-a-target-horizontally-vertically-or-in-all-2D-directions","type":"heading","text":"Follow a target horizontally, vertically, or in all 2D directions","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"CameraFollowHelper"},{"type":"text","text":" supports independent horizontal and vertical axis controls."},{"type":"text","text":" "},{"type":"text","text":"Horizontal following is enabled by default, and vertical following is disabled."}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Follow mode"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"followsHorizontal"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"followsVertical"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Horizontal (default)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Vertical","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"false","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"true","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"All 2D directions","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"true","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"true","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Neither axis","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"false","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"false","type":"codeVoice"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A disabled axis retains the camera’s existing position. Enabling both axes follows"},{"type":"text","text":" "},{"type":"text","text":"any combination of horizontal, vertical, and diagonal target movement; it does not"},{"type":"text","text":" "},{"type":"text","text":"rotate the camera or automatically change zoom."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retain the helper as a scene property and update it after physics. This example"},{"type":"text","text":" "},{"type":"text","text":"follows the target on both axes:"}]},{"type":"codeListing","syntax":"swift","code":["let follow = CameraFollowHelper(","    camera: cameraNode,","    target: hero,","    viewportSize: visibleWorldSize,","    bounds: playableBounds",")","follow.followsHorizontal = true","follow.followsVertical = true","follow.lookAhead = .zero","follow.smoothing = 8","","\/\/ From the scene's didSimulatePhysics hook:","follow.update(deltaTime: frameDelta)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For vertical-only following, set "},{"type":"codeVoice","code":"followsHorizontal = false"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"followsVertical = true"},{"text":". For horizontal-only following, use the defaults.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Smoothing and look-ahead work on each enabled axis. Smoothing is an exponential","type":"text"},{"text":" ","type":"text"},{"text":"response per second; zero snaps immediately. Set ","type":"text"},{"code":"lookAhead.dx","type":"codeVoice"},{"type":"text","text":" for a horizontal"},{"type":"text","text":" "},{"type":"text","text":"offset and "},{"type":"codeVoice","code":"lookAhead.dy"},{"type":"text","text":" for a vertical offset. These offsets are fixed in"},{"type":"text","text":" "},{"type":"text","text":"camera-parent coordinates; they do not automatically reverse with target movement."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional "},{"type":"codeVoice","code":"bounds"},{"type":"text","text":" constrain each enabled axis and use camera-parent coordinates."},{"type":"text","text":" "},{"type":"text","text":"A world smaller than the viewport centers on that axis. Supply bounds covering the"},{"type":"text","text":" "},{"type":"text","text":"full playable height for vertical or all-direction following. Terrain-only bounds"},{"type":"text","text":" "},{"type":"text","text":"that are no taller than the viewport prevent vertical travel even when"},{"type":"text","text":" "},{"type":"codeVoice","code":"followsVertical"},{"type":"text","text":" is enabled. Set "},{"type":"codeVoice","code":"bounds = nil"},{"type":"text","text":" for unrestricted following. Update "},{"type":"codeVoice","code":"viewportSize"},{"type":"text","text":" when the view, scale mode, or camera zoom changes;"},{"type":"text","text":" "},{"type":"text","text":"it must describe the visible world dimensions, rather than screen pixels. Keep the"},{"type":"text","text":" "},{"type":"text","text":"camera unrotated. The helper handles target coordinate conversion, weak references,"},{"type":"text","text":" "},{"type":"text","text":"invalid frame deltas, and targets removed from the scene. Reset your frame timer after"},{"type":"text","text":" "},{"type":"text","text":"pausing to avoid a large resume delta."}]}]}],"variants":[{"paths":["\/documentation\/scroller2d\/levelhelpers"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Scroller2d\/documentation\/Scroller2d"]]},"references":{"doc://Scroller2d/documentation/Scroller2d/AppSharedSceneBaseLifecycle":{"identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/AppSharedSceneBaseLifecycle","kind":"article","url":"\/documentation\/scroller2d\/appsharedscenebaselifecycle","abstract":[{"text":"When using ","type":"text"},{"identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/AppSharedSceneBase","type":"reference","isActive":true},{"text":" how does Scroller2d provide feedback to my code.","type":"text"}],"title":"AppSharedSceneBase Lifecycle","role":"article","type":"topic"},"doc://Scroller2d/documentation/Scroller2d/Configuration":{"identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/Configuration","kind":"article","url":"\/documentation\/scroller2d\/configuration","abstract":[{"type":"text","text":"Browse the core data types that define levels, scenes, and gameplay objects."}],"title":"Configuration","role":"collectionGroup","type":"topic"},"doc://Scroller2d/documentation/Scroller2d/BaseTypeStructure":{"kind":"article","title":"Base Structure","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/BaseTypeStructure","url":"\/documentation\/scroller2d\/basetypestructure","abstract":[{"text":"Browse the core data types that define levels, scenes, and gameplay objects.","type":"text"}],"type":"topic","role":"collectionGroup"},"appicon.png":{"type":"image","alt":"Scroller2d","variants":[{"url":"\/images\/Scroller2d\/appicon.png","traits":["1x","light"]}],"identifier":"appicon.png"},"doc://Scroller2d/documentation/Scroller2d/Extensions":{"identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/Extensions","kind":"article","url":"\/documentation\/scroller2d\/extensions","abstract":[{"type":"text","text":"Browse the core data types that define levels, scenes, and gameplay objects."}],"title":"Extensions","role":"collectionGroup","type":"topic"},"doc://Scroller2d/documentation/Scroller2d/Other":{"title":"Other","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/Other","role":"collectionGroup","kind":"article","url":"\/documentation\/scroller2d\/other","type":"topic","abstract":[{"type":"text","text":"Browse the core data types that define levels, scenes, and gameplay objects."}]},"doc://Scroller2d/documentation/Scroller2d/DecisionPoint":{"identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/DecisionPoint","kind":"article","url":"\/documentation\/scroller2d\/decisionpoint","abstract":[{"text":"Deciding to use the game object helpers or roll your own.","type":"text"}],"title":"Decision Point","role":"article","type":"topic"},"doc://Scroller2d/documentation/Scroller2d/ManagedCallbacks":{"role":"article","type":"topic","abstract":[{"type":"text","text":"Deciding to use the game object helpers or roll your own."}],"identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/ManagedCallbacks","kind":"article","title":"How does Scroller2d manage callbacks","url":"\/documentation\/scroller2d\/managedcallbacks"},"doc://Scroller2d/documentation/Scroller2d/SharedObjects":{"kind":"article","title":"Shared Structures","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/SharedObjects","url":"\/documentation\/scroller2d\/sharedobjects","abstract":[{"text":"Browse the core data types that define levels, scenes, and gameplay objects.","type":"text"}],"type":"topic","role":"collectionGroup"},"doc://Scroller2d/documentation/Scroller2d/GettingStarted":{"role":"article","type":"topic","abstract":[{"type":"text","text":"Create a level and assign background and ground elements."}],"identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/GettingStarted","kind":"article","title":"Getting Started with Scroller2d","url":"\/documentation\/scroller2d\/gettingstarted"},"doc://Scroller2d/documentation/Scroller2d":{"role":"collection","type":"topic","abstract":[{"type":"text","text":"Scroller2d is an api interface and visual editor that allows a developer to quickly create 2d SpriteKit games with minimal effort."}],"identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d","kind":"symbol","title":"Scroller2d","images":[{"type":"icon","identifier":"appicon.png"}],"url":"\/documentation\/scroller2d"},"doc://Scroller2d/documentation/Scroller2d/BaseClasses":{"abstract":[{"text":"Browse the core data types that define levels, scenes, and gameplay objects.","type":"text"}],"url":"\/documentation\/scroller2d\/baseclasses","role":"collectionGroup","type":"topic","title":"Base Classes","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/BaseClasses","kind":"article"},"doc://Scroller2d/documentation/Scroller2d/Enumerations":{"abstract":[{"type":"text","text":"Browse the core data types that define levels, scenes, and gameplay objects."}],"url":"\/documentation\/scroller2d\/enumerations","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/Enumerations","kind":"article","type":"topic","title":"Enumerations","role":"collectionGroup"},"doc://Scroller2d/documentation/Scroller2d/AppSharedSceneBase":{"kind":"symbol","title":"AppSharedSceneBase","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/AppSharedSceneBase","url":"\/documentation\/scroller2d\/appsharedscenebase","abstract":[{"text":"The base SKScene implementation for Scroller2d.","type":"text"}],"navigatorTitle":[{"text":"AppSharedSceneBase","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AppSharedSceneBase","kind":"identifier"}],"type":"topic","role":"symbol"}}}