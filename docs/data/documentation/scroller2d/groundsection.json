,{"type":"text","text":" to an image name. For a two-frame wave, create"},{"type":"text","text":" "},{"type":"text","text":"a sprite atlas named "},{"type":"codeVoice","code":"water_waves"},{"type":"text","text":" with images named "},{"type":"codeVoice","code":"wave_01"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"wave_02"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Give both frames matching dimensions and a consistent waterline. The helper","type":"text"},{"text":" ","type":"text"},{"text":"plays atlas frames in filename order. Configure playback in the section’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"animation"},{"text":" dictionary.","type":"text"}]},{"type":"codeListing","syntax":"xml","code":["<dict>","    <key>groundType<\/key>","    <string>Gap<\/string>","    <key>distance<\/key>","    <string>{240, 48}<\/string>","    <key>image<\/key>","    <string>water_waves<\/string>","    <key>animation<\/key>","    <dict>","        <key>frequency<\/key>","        <string>foreverAutomatically<\/string>","        <key>waitPerAnimationFrame<\/key>","        <dict>","            <key>idle<\/key>","            <real>0.2<\/real>","        <\/dict>","    <\/dict>","<\/dict>"]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"foreverAutomatically"},{"text":" to loop the atlas. The ","type":"text"},{"type":"codeVoice","code":"once"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"foreverResetManual"},{"text":" frequencies play a single cycle when built. Other","type":"text"},{"text":" ","type":"text"},{"text":"frequencies display a static frame. The idle frame duration defaults to","type":"text"},{"text":" ","type":"text"},{"text":"0.2 seconds. Set ","type":"text"},{"type":"codeVoice","code":"animationFrameStart"},{"text":" to select a different starting frame,","type":"text"},{"text":" ","type":"text"},{"text":"using a zero-based index.","type":"text"}]},{"type":"heading","anchor":"Configure-ground-collisions","text":"Configure ground collisions","level":2},{"type":"paragraph","inlineContent":[{"text":"For ","type":"text"},{"type":"codeVoice","code":"Ground"},{"text":", set the ","type":"text"},{"code":"collisionMasks","type":"codeVoice"},{"type":"text","text":" dictionary using the SDK’s"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/CollisionDetection"},{"type":"text","text":" keys and comma-separated "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/collisionTypes"},{"type":"text","text":" names."}]},{"syntax":"xml","type":"codeListing","code":["<key>collisionMasks<\/key>","<dict>","    <key>category<\/key>","    <string>floor<\/string>","    <key>collision<\/key>","    <string>humanPlayer,enemyTouch<\/string>","    <key>contact<\/key>","    <string>humanPlayer<\/string>","<\/dict>"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Omitted fields default to category bit "},{"code":"1","type":"codeVoice"},{"type":"text","text":", all collision bits, and zero"},{"type":"text","text":" "},{"type":"text","text":"contact bits. An empty string sets the corresponding mask to zero."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/scroller2d\/groundsection"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/Scroller2d\/documentation\/Scroller2d\/GroundSection","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Scroller2d\/documentation\/Scroller2d"]]},"abstract":[{"text":"A structure representing all the properties and types needed to create a specific horizontal ground section.","type":"text"}],"topicSections":[{"anchor":"Gap-materials","title":"Gap materials","identifiers":["doc:\/\/Scroller2d\/documentation\/Scroller2d\/GroundSection\/groundTyp